# Display name on screens (AD-24). An empty value falls back inside src/config/env.ts only.
EXPO_PUBLIC_BRAND_NAME=Gift List

# API origin. Do not hardcode this address in UI source.
# Android emulator reaches the host machine at http://10.0.2.2:3000, not localhost.
# Expo web (http://localhost:8081) is another origin. Leave this empty and the
# browser calls :8081/api, which is the Metro page, not JSON. For local web set:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Next then answers CORS for that page only while NODE_ENV is not production.
EXPO_PUBLIC_API_BASE_URL=

# Optional. When empty, «Написать автору» stays visible and does not navigate.
# EXPO_PUBLIC_AUTHOR_URL=
