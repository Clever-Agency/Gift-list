# Display name on screens (AD-24): an optional override. Unset or blank falls
# back to PRODUCT_NAME in packages/contracts/src/brand.ts (WishMoon).
EXPO_PUBLIC_BRAND_NAME=WishMoon

# API origin. Do not hardcode this address in UI source.
# The value is baked into the bundle at build time, so choose it per build target:
#   Android emulator: http://10.0.2.2:3000 (10.0.2.2 is reachable only there)
#   LAN / phone:      http://192.168.1.20:3000 (the host's LAN address)
#   Expo web (:8081): http://localhost:3000
#   Next web build:   leave empty — the site and /api/v1 are same-origin
# `npm run mobile:build:lan` requires a LAN address and rejects localhost/10.0.2.2;
# `npm run mobile:build:web` (and the Next build) clears this value for same-origin.
EXPO_PUBLIC_API_BASE_URL=

# Public site origin for outbound links (Q-2): the wishlist share link is
# `{origin}/l/{publicToken}`. Empty falls back to EXPO_PUBLIC_API_BASE_URL,
# because the site and the API share one domain (AD-26) and App Links claim
# /l/* on that host. A deployed Expo-web build has one more fallback: the origin
# of the page that serves it, so it needs no value here and no domain is baked
# in. That fallback is only right where the SPA and /l/* share a host; with
# `npm run mobile:web` the page is Metro (:8081), which serves no /l/*, so for a
# local copyable link set EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000 (Next).
# Native has no page origin, so set this (or the API base) for the app. Must be
# an http(s) origin without a path; any other value yields no link instead of a
# wrong host. Baked into the bundle at build time.
EXPO_PUBLIC_WEB_ORIGIN=
