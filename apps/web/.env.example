# PostgreSQL connection string (local docker or managed Neon).
# Example local: postgresql://postgres:postgres@localhost:5432/gift_list?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Better Auth (AD-3). Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-characters-of-randomness"
BETTER_AUTH_URL="http://localhost:3000"

# Display name (AD-24). When unset, getBrandName() uses Gift List.
BRAND_NAME="Gift List"

# Resend (password reset). Leave both unset to skip the letter (sign-in still
# works, and the forgot response stays the same). A non-empty key is used as-is,
# including this placeholder, and a rejected send is only logged.
# Address, or a display name plus an address.
# RESEND_API_KEY="replace-me"
# EMAIL_FROM="noreply@example.com"

# App Links / Universal Links. Leave unset until the store listing exists.
# Empty values are ignored — they are not replaced with a placeholder team id.
# APPLE_TEAM_ID="ABCDE12345"
# ANDROID_SHA256_CERT_FINGERPRINTS="AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99"

# Только для разработки: доверенные origins Expo Go и dev client (AD-3, AD-16). Раскомментируйте локально, в проде не задавать.
# Expo web (npm run web в apps/mobile) — добавьте его http-origin: он же получит CORS на /api/v1.
# AUTH_DEV_TRUSTED_ORIGINS="exp://,exp+giftlist://,http://localhost:8081"
