{
  "name": "@gift-list/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/sync-spa.mjs && prisma generate && next build && node ./scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@gift-list/contracts": "*",
    "@gift-list/ui": "*",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.31.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
