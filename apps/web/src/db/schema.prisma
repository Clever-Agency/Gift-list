// Gift List — Prisma schema (AD-4).
// Models (User, List, Gift, …) arrive in stories 1.2+. R1 forbids payment tables (AD-11).

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core tables (AD-3). Field names follow Better Auth defaults.
model User {
  id             String   @id @default(cuid(2))
  name           String // displayName
  /// AD-27: `normalizeForSearch(name)`, written whenever `name` is written.
  nameNormalized String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  image          String?
  nick           String
  nickNormalized String   @unique
  hideFromSearch Boolean  @default(false)
  /// Set once from Accept-Language at registration (AD-27).
  locale         String   @default("ru")
  /// Null until the client reports an IANA zone. A stored value is not overwritten (Story 1.8).
  timeZone       String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
  lists    List[]

  /// Gifts this user holds a reservation on (AD-9). Active reservations are `status=RESERVED`.
  reservedGifts Gift[] @relation("GiftReservedBy")

  friendshipInvitesSent     FriendshipInvite[] @relation("FriendshipInviteFrom")
  friendshipInvitesReceived FriendshipInvite[] @relation("FriendshipInviteTo")
  friendshipsAsLow          Friendship[]       @relation("FriendshipLow")
  friendshipsAsHigh         Friendship[]       @relation("FriendshipHigh")
  blocksMade                Block[]            @relation("BlockBlocker")
  blocksReceived            Block[]            @relation("BlockBlocked")

  inviteCooldownsAsLow        InviteCooldown[] @relation("InviteCooldownLow")
  inviteCooldownsAsHigh       InviteCooldown[] @relation("InviteCooldownHigh")
  inviteCooldownsRejectedFrom InviteCooldown[] @relation("InviteCooldownRejectedFrom")
}

model Session {
  id        String   @id @default(cuid(2))
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// Exactly one list per user (AD-6). `publicToken` is immutable after insert.
model List {
  id          String   @id @default(cuid(2))
  ownerId     String   @unique
  publicToken String   @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  gifts Gift[]
}

// Wishlist item (AD-8, AD-9). R1 keeps the reservation on `Gift`; there is no `Reservation` table.
// `status`, reservation/close columns and `archivedAt` are written only by `GiftStatusService`.
model Gift {
  id            String         @id @default(cuid(2))
  listId        String
  title         String
  description   String?
  /// Integer minor units (two decimals); absent when the owner gave no price (D-36).
  priceAmount   Int?
  /// Non-empty price without a chosen currency is stored as `USD` (AD-25).
  priceCurrency GiftCurrency?
  linkUrl       String?
  visibility    GiftVisibility @default(PUBLIC)
  quantity      GiftQuantity   @default(SINGLE)
  /// Local end-of-day date; drives the `wish-expiry` cron (D-26).
  expiresOn     DateTime?      @db.Date
  /// Manual or expiry archive; hidden from the active list (AD-8, D-26).
  archivedAt    DateTime?      @db.Timestamptz(3)
  status        GiftStatus     @default(OPEN)

  // Reservation (AD-9). `reservation*` and `holderVisible*` exist while `status=RESERVED`.
  reservedById           String?
  reservedAt             DateTime?         @db.Timestamptz(3)
  /// End of the chosen date in `reservationTimeZone`, computed on the server (ARCH-A14).
  reservationDueAt       DateTime?         @db.Timestamptz(3)
  /// IANA snapshot taken when the reservation was created; not a second source of the user's zone.
  reservationTimeZone    String?
  reservationPhase       ReservationPhase?
  reservationPhaseAt     DateTime?         @db.Timestamptz(3)
  reservationBought      Boolean           @default(false)
  holderVisibleToOwner   Boolean           @default(false)
  holderVisibleToOthers  Boolean           @default(true)
  /// Title as it was when the gift was reserved; used by holder notifications and emails (A-14).
  titleSnapshotOnReserve String?

  // Closure (AD-8). `reserved*` are kept for audit; active reservations are `status=RESERVED` only.
  closedAt         DateTime?             @db.Timestamptz(3)
  closedFromStatus GiftClosedFromStatus?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  list       List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Account deletion releases reservations through `GiftStatusService` first (AD-20); a raw
  /// `onDelete` that would drop the holder silently is blocked here.
  reservedBy User?     @relation("GiftReservedBy", fields: [reservedById], references: [id], onDelete: Restrict)
  /// Story 2.5 / AD-22: fixed catalog references and custom texts.
  tags       GiftTag[]

  @@index([listId])
  /// "My reservations" (FR-25) and the reservation-card read matrix (AD-7).
  @@index([reservedById, status])
  /// Reservation timer cron scans (AD-9).
  @@index([status, reservationPhase, reservationDueAt])
  @@index([status, reservationPhase, reservationPhaseAt])
}

// Fixed tag catalog (AD-22, AD-27). Rows are data, not JSON catalogs: `slug` is
// immutable and `labels` must carry a label for every `SUPPORTED_LOCALES` entry.
// ADMIN adds rows in Story 10.2 (and must validate `labels` there); clients only
// ever show the server-provided label.
model Tag {
  id        String   @id @default(cuid(2))
  slug      String   @unique
  /// Locale → label, e.g. `{"ru":"мечта"}`; one key per `SUPPORTED_LOCALES` entry.
  labels    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  giftTags GiftTag[]
}

// Tag on a wish (Story 2.5, AD-22). A row carries a catalog reference (`tagId`),
// a custom text, or both after approval; at least one is required. Custom text is
// shown with the wish but stays out of aggregates until ADMIN approves it
// (Story 10.2). Approval links the row to a catalog tag and sets
// `aggregateEligible`; rejection leaves the text as is. A migration CHECK
// enforces both invariants at the database level.
model GiftTag {
  id                String   @id @default(cuid(2))
  giftId            String
  tagId             String?
  /// Custom tag text; null for a catalog tag. Story 2.5 caps it at 30 characters;
  /// trimming/normalization is the write path's job (Story 2.5.4).
  customText        String?  @db.VarChar(30)
  /// AD-22: a writer adding a fixed tag sets this to true; the default keeps a
  /// custom tag out of aggregates until ADMIN approval. The CHECK requires
  /// `tagId` whenever this is true.
  aggregateEligible Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)
  /// A catalog tag cannot be deleted while wishes still reference it.
  tag  Tag? @relation(fields: [tagId], references: [id], onDelete: Restrict)

  /// One catalog tag and one identical custom text per wish.
  @@unique([giftId, tagId])
  @@unique([giftId, customText])
  /// Aggregate reads group by catalog tag.
  @@index([tagId])
}

// Closed value sets from AD-7 / AD-8 / AD-9 / AD-25. `COLLECTION` is not part of R1 (AD-11).
enum GiftStatus {
  OPEN
  RESERVED
  CLOSED
}

enum GiftVisibility {
  PUBLIC
  FRIENDS
  SECRET
}

enum GiftQuantity {
  SINGLE
  UNLIMITED
}

enum GiftCurrency {
  USD
  EUR
  CNY
  BYN
  RUB
}

enum ReservationPhase {
  ACTIVE
  AWAITING_GIVER
  AWAITING_OWNER
  GIVEN
}

/// Status a gift returns to when the owner undoes a close inside `UNDO_WINDOW` (AD-8, D-43).
enum GiftClosedFromStatus {
  OPEN
  RESERVED
}

// Fixed-window request counters (soft rate limit, R1). One row per `key`.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @db.Timestamptz(3)
}

// Friendship protocol (AD-10, Story 4.1). Pending is the mere presence of a
// directed `FriendshipInvite`: there is no status column and no second row per
// direction. An accepted friendship is one undirected edge with the canonical
// pair `userLowId < userHighId`; the migration CHECK and the UNIQUE index make a
// second row in the opposite direction impossible. `Block` is only read here —
// the storage is shared with Story 4.5, which owns creating and removing blocks.
model FriendshipInvite {
  id         String   @id @default(cuid(2))
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  fromUser User @relation("FriendshipInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendshipInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  /// One pending invite per direction; a repeat send keeps the same row.
  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Friendship {
  id         String   @id @default(cuid(2))
  userLowId  String
  userHighId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  /// Canonical ordered pair: at most one edge per two users (CHECK low < high).
  @@unique([userLowId, userHighId])
  @@index([userHighId])
}

model Block {
  id        String   @id @default(cuid(2))
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Rejection cooldown of one canonical pair (AD-10 step 3, A-16, Story 4.2.1).
//
// Reject deletes the pending invite and writes this row with `until = now+24h`
// (UTC); no `Friendship` edge is created. The table is one row per pair, in the
// same `userLowId < userHighId` order as `Friendship`, so a repeat send reads
// the same key. `rejectedFromUserId` is the sender of the rejected invite (A):
// only that side may be shown "rejected"; the recipient (B) sees the remaining
// hours (Story 4.2.2). There is no cron and no status column: a row is live
// only while `until > now`, and a successful new send deletes an expired row in
// the same transaction. `Block` is still only read here (Story 4.5 owns blocks).
model InviteCooldown {
  id                 String   @id @default(cuid(2))
  userLowId          String
  userHighId         String
  /// Sender of the rejected invite; must be one of the two pair members.
  rejectedFromUserId String
  /// Live only while `until > now`; never extended by a repeat send.
  until              DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  userLow      User @relation("InviteCooldownLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh     User @relation("InviteCooldownHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  rejectedFrom User @relation("InviteCooldownRejectedFrom", fields: [rejectedFromUserId], references: [id], onDelete: Cascade)

  /// One cooldown per canonical pair (CHECK low < high in the migration).
  @@unique([userLowId, userHighId])
  @@index([userHighId])
}
