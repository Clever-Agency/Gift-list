{
  "name": "gift-list",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gift-list/web",
    "build": "npm run build -w @gift-list/web",
    "start": "npm run start -w @gift-list/web",
    "test": "node scripts/run-suite.mjs",
    "lint": "npm run lint -w @gift-list/web && npm run lint -w @gift-list/mobile && npm run lint -w @gift-list/contracts && npm run lint -w @gift-list/ui && node scripts/check-boundaries.mjs",
    "mobile:start": "npm run start -w @gift-list/mobile",
    "mobile:web": "npm run web -w @gift-list/mobile",
    "mobile:build:web": "npm run build:web -w @gift-list/mobile",
    "mobile:build:lan": "npm run build:lan -w @gift-list/mobile",
    "mobile:build:emulator": "npm run build:emulator -w @gift-list/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @gift-list/web",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@tamagui/native": "3.1.10"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-native-web-vite": "10.6.7",
    "storybook": "10.6.7"
  }
}
